# Copy this file to .env.local and fill in the values below.
# .env.local is gitignored - never commit real credentials.

# Only needed if the backend isn't running on the default
# http://127.0.0.1:8000 (see src/lib/api.ts).
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Google OAuth Client ID for the "Continue with Google" button on the
# Login/Signup pages. Must be the SAME Client ID set as GOOGLE_CLIENT_ID
# in backend/.env - see that file for how to create one. This value is
# public by design (it identifies the app to Google, it isn't a secret),
# but the button is hidden if it's left blank.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
