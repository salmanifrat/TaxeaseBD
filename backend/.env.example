# Copy this file to .env and adjust as needed.
# The launch scripts (start-mac.sh / start-windows.bat) do this for you
# automatically, including generating a random JWT_SECRET.

# Used to sign login session tokens. Must be a long random string in
# any environment other than your own machine.
JWT_SECRET=change-this-to-a-long-random-string

# SQLite is fine for local dev. Point this at a real Postgres URL in
# production, e.g. postgresql://user:pass@host/dbname
DATABASE_URL=sqlite:///./taxease.db

# Comma-separated list of frontend origins allowed to call this API.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Port the backend listens on. The frontend defaults to expecting 8000
# (see frontend/src/lib/api.ts) - change both together if you change this.
PORT=8000
