# Copy this file to .env and adjust as needed.
# The launch scripts (start-mac.sh / start-windows.bat) do this for you
# automatically, including generating a random JWT_SECRET.

# Used to sign login session tokens. Must be a long random string in
# any environment other than your own machine.
JWT_SECRET=change-this-to-a-long-random-string

# SQLite is fine for local dev. Point this at a real Postgres URL in
# production, e.g. postgresql://user:pass@host/dbname
DATABASE_URL=sqlite:///./taxease.db

# Comma-separated list of frontend origins allowed to call this API.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Port the backend listens on. The frontend defaults to expecting 8000
# (see frontend/src/lib/api.ts) - change both together if you change this.
PORT=8000

# Optional. Get a free key at https://console.groq.com - without it, the
# AI Assistant still works but answers come from a fixed template instead
# of a naturally-phrased, Groq-generated one. Never used to answer without
# retrieved law text backing it - see backend/llm.py.
GROQ_API_KEY=
# Override only if the default model gets deprecated - run
# `client.models.list()` (see backend/llm.py) or check
# console.groq.com/docs/models for the current lineup.
# GROQ_MODEL=openai/gpt-oss-120b

# --- Signup email verification (Gmail SMTP) ---
# Sends the 6-digit code new users must enter to finish signing up.
# Create an "App Password" in your Google Account -> Security -> 2-Step
# Verification -> App Passwords (requires 2FA to be on) and put it here -
# never your real Gmail login password. Without these set, the code is
# printed to this backend's console instead of emailed, so signup still
# works for local development. See backend/mailer.py.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# --- "Continue with Google" sign-in/signup ---
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials, and add your
# frontend's URL(s) under "Authorized JavaScript origins" (e.g.
# http://localhost:3000). Paste the Client ID here AND in
# frontend/.env.local as NEXT_PUBLIC_GOOGLE_CLIENT_ID - both must match.
# Without this set, the Google button is hidden. See backend/google_oauth.py.
GOOGLE_CLIENT_ID=
